              <td><strong>71.4% Recovery</strong></td>
              <td><strong>1.2 Gallons / Day</strong></td>
              <td><strong>438 Gallons</strong></td>
              <td><strong>~$2.19 / year</strong></td>
            </tr>
          </tbody>
        </table>

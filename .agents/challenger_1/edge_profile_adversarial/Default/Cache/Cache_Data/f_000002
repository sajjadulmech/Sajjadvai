/* ==========================================================================
   ClearTapLab Master Design System & Web Application Stylesheet
   Brand: ClearTapLab (ClearTapLab.com)
   Visual Theme: Clean Engineering Authority (Reference Ocean/Cyan/Navy Palette)
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

:root {
  /* ========================================================================
     THEME COLOR TOKENS (Matched to Reference Palette)
     ======================================================================== */
  
  /* Primary Deep Navy (Headings, Main Text & Dark Structure) */
  --ctl-navy: #0D2040;
  --ctl-navy-light: #163660;
  --ctl-navy-dark: #071930;
  
  /* Vibrant Ocean Cyan / Blue (Primary CTAs, Active States & Highlights) */
  --ctl-aqua: #0084D1;
  --ctl-aqua-hover: #006EB3;
  --ctl-aqua-light: #E0F2FE;
  --ctl-aqua-ultra-light: #F0F8FD;
  --ctl-cyan-accent: #00A8E8;
  --ctl-sapphire-accent: #0077CC;
  
  /* Purity Bio-Teal (Diagnostics, Safety & Certified Standards) */
  --ctl-teal: #029E9D;
  --ctl-teal-light: #E0F7F6;
  
  /* Warning / Contaminant Orange (Symptom Warnings & Thresholds) */
  --ctl-orange: #E65100;
  --ctl-orange-light: #FFF3E0;
  
  /* Surfaces & Backgrounds */
  --ctl-bg-ice: #F4FAFD;
  --ctl-bg-soft: #EBF5FA;
  --ctl-surface: #FFFFFF;
  --ctl-card-bg: #FFFFFF;
  --ctl-card-subtle: #F8FBFE;
  
  /* Borders & Dividers */
  --ctl-border: #E1EDF5;
  --ctl-border-light: #EDF5FA;
  --ctl-border-focus: #BAE0F7;
  
  /* Text Colors */
  --ctl-text-main: #0D2040;
  --ctl-text-muted: #526E88;
  --ctl-text-light: #8FA8BF;
  
  /* Dark Container Ocean Colors (Trust Section & Footer) */
  --ctl-ocean-deep: #08436B;
  --ctl-ocean-darker: #062F4C;
  --ctl-ocean-card: #0A3654;
  --ctl-ocean-border: #165682;
  --ctl-footer-bg: #051E33;
  --ctl-footer-text: #8CAFC9;

  /* Typography */
  --ctl-font-heading: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --ctl-font-body: 'Inter', system-ui, -apple-system, sans-serif;
  --ctl-font-mono: 'JetBrains Mono', monospace;

  /* Layout & Radii */
  --ctl-radius-sm: 8px;
  --ctl-radius-md: 14px;
  --ctl-radius-lg: 20px;
  --ctl-radius-full: 9999px;

  /* Elevation Shadows */
  --ctl-shadow-sm: 0 2px 6px rgba(13, 32, 64, 0.04), 0 1px 2px rgba(13, 32, 64, 0.02);
  --ctl-shadow-md: 0 6px 18px rgba(13, 32, 64, 0.06), 0 2px 6px rgba(13, 32, 64, 0.03);
  --ctl-shadow-lg: 0 14px 34px rgba(9, 75, 114, 0.09), 0 4px 12px rgba(9, 75, 114, 0.04);
  --ctl-shadow-modal: 0 25px 60px rgba(7, 25, 48, 0.3);
  
  /* Transitions */
  --ctl-transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --ctl-transition-base: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==========================================================================
   CSS Reset & Base Standards
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--ctl-font-body);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--ctl-text-main);
  background-color: var(--ctl-bg-ice);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

img, svg {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: var(--ctl-aqua);
  text-decoration: none;
  transition: color var(--ctl-transition-fast);
}

a:hover {
  color: var(--ctl-aqua-hover);
}

button {
  cursor: pointer;
  border: none;
  background: none;
  font-family: inherit;
}

input, select, textarea {
  font-family: inherit;
  font-size: 1rem;
}

:focus-visible {
  outline: 3px solid var(--ctl-aqua);
  outline-offset: 2px;
}

.ctl-container {
  width: 100%;
  max-width: 1200px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 20px;
  padding-right: 20px;
}

/* ==========================================================================
   Component Utilities & Tokens
   ========================================================================== */

/* Badge Pills */
.ctl-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  background-color: var(--ctl-aqua-light);
  color: var(--ctl-sapphire-accent);
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-radius: var(--ctl-radius-full);
  border: 1px solid #BAE6FD;
}

.ctl-badge-teal {
  background-color: var(--ctl-teal-light);
  color: var(--ctl-teal);
  border-color: rgba(2, 158, 157, 0.25);
}

.ctl-badge-warning {
  background-color: var(--ctl-orange-light);
  color: var(--ctl-orange);
  border-color: rgba(230, 81, 0, 0.25);
}

.ctl-badge-dark {
  background-color: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.25);
}

/* Cards */
.ctl-card {
  background: var(--ctl-card-bg);
  border: 1px solid var(--ctl-border);
  border-radius: var(--ctl-radius-lg);
  padding: 24px;
  box-shadow: var(--ctl-shadow-sm);
  transition: transform var(--ctl-transition-base), box-shadow var(--ctl-transition-base), border-color var(--ctl-transition-base);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.ctl-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--ctl-shadow-md);
  border-color: var(--ctl-border-focus);
}

/* Callout Spec Boxes */
.ctl-spec-box {
  background-color: #F0FDF4;
  border-left: 4px solid var(--ctl-teal);
  border-radius: var(--ctl-radius-sm);
  padding: 18px 20px;
  margin: 20px 0;
  font-size: 0.95rem;
  border-top: 1px solid var(--ctl-border-light);
  border-right: 1px solid var(--ctl-border-light);
  border-bottom: 1px solid var(--ctl-border-light);
}

.ctl-spec-box h4 {
  color: #065F46;
  font-weight: 700;
  margin-bottom: 8px;
}

.ctl-spec-box.warning {
  background-color: #FFFDF7;
  border-left-color: var(--ctl-orange);
  border-color: #FFE6C7;
}

.ctl-spec-box.warning h4 {
  color: #B43403;
}

.ctl-spec-box.info {
  background-color: var(--ctl-aqua-ultra-light);
  border-left-color: var(--ctl-aqua);
  border-color: #D3ECF9;
}

.ctl-spec-box.info h4 {
  color: var(--ctl-sapphire-accent);
}

/* Action Buttons */
.ctl-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 13px 26px;
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: var(--ctl-radius-sm);
  transition: all var(--ctl-transition-fast);
  text-align: center;
  white-space: nowrap;
}

.ctl-btn-primary {
  background: linear-gradient(180deg, #008CD7 0%, #0077CC 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4px 14px rgba(0, 119, 204, 0.28);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.ctl-btn-primary:hover {
  background: linear-gradient(180deg, #0077CC 0%, #0066B3 100%);
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(0, 119, 204, 0.38);
}

.ctl-btn-outline {
  background-color: #FFFFFF;
  color: var(--ctl-navy) !important;
  border: 1.5px solid #C8E3F5;
  box-shadow: 0 1px 3px rgba(13, 32, 64, 0.04);
}

.ctl-btn-outline:hover {
  background-color: var(--ctl-aqua-ultra-light);
  border-color: var(--ctl-aqua);
  color: var(--ctl-aqua) !important;
}

.ctl-btn-sm {
  padding: 8px 16px;
  font-size: 0.85rem;
}

/* Step Container */
.ctl-step-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
  margin: 30px 0;
}

.ctl-step-card {
  background-color: var(--ctl-surface);
  border: 1px solid var(--ctl-border);
  border-radius: var(--ctl-radius-lg);
  padding: 30px;
  position: relative;
  box-shadow: var(--ctl-shadow-sm);
  transition: all var(--ctl-transition-base);
}

.ctl-step-card:hover {
  border-color: var(--ctl-border-focus);
  transform: translateY(-3px);
  box-shadow: var(--ctl-shadow-md);
}

.ctl-step-number {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--ctl-aqua);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--ctl-font-mono);
  font-size: 1.1rem;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 18px;
  box-shadow: 0 3px 10px rgba(0, 132, 209, 0.3);
}

/* Responsive Tables */
.ctl-table-wrapper {
  overflow-x: auto;
  margin: 24px 0;
  border-radius: var(--ctl-radius-md);
  border: 1px solid var(--ctl-border);
  background: var(--ctl-surface);
  box-shadow: var(--ctl-shadow-sm);
}

.ctl-table {
  width: 100%;
  min-width: 580px;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.92rem;
}

.ctl-table th {
  background-color: #EBF5FA;
  color: var(--ctl-navy);
  font-weight: 700;
  padding: 14px 16px;
  border-bottom: 2px solid var(--ctl-border);
}

.ctl-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--ctl-border-light);
  color: var(--ctl-text-muted);
}

.ctl-table tr:last-child td {
  border-bottom: none;
}

.ctl-table tr:hover td {
  background-color: #F8FBFE;
}

/* Spec Grid inside Reviews */
.ctl-spec-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 12px;
  background: #F4FAFD;
  border: 1px solid var(--ctl-border);
  border-radius: var(--ctl-radius-md);
  padding: 16px;
  margin: 16px 0;
}

.ctl-spec-item {
  text-align: center;
}

.ctl-spec-item .label {
  font-size: 0.72rem;
  text-transform: uppercase;
  color: var(--ctl-text-light);
  font-weight: 700;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}

.ctl-spec-item .value {
  font-family: var(--ctl-font-mono);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ctl-navy);
}

/* Author Box */
.ctl-author-box {
  display: flex;
  gap: 20px;
  align-items: center;
  background: var(--ctl-surface);
  border: 1px solid var(--ctl-border);
  border-radius: var(--ctl-radius-lg);
  padding: 24px;
  margin: 40px 0 20px;
  box-shadow: var(--ctl-shadow-sm);
}

.ctl-author-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid var(--ctl-aqua);
}

.ctl-author-meta h4 {
  margin: 0 0 4px;
  font-size: 1.1rem;
  color: var(--ctl-navy);
}

.ctl-author-role {
  font-size: 0.82rem;
  color: var(--ctl-aqua);
  font-weight: 700;
  margin-bottom: 8px;
}

.ctl-author-meta p {
  font-size: 0.88rem;
  color: var(--ctl-text-muted);
  line-height: 1.5;
  margin: 0;
}

@media (max-width: 640px) {
  .ctl-author-box {
    flex-direction: column;
    text-align: center;
    padding: 20px;
    gap: 14px;
  }
}

/* Monospace Inline & Formula Callout Box */
.ctl-mono {
  font-family: var(--ctl-font-mono);
  font-size: 0.9em;
  font-weight: 600;
  color: var(--ctl-navy);
  background-color: rgba(0, 132, 209, 0.08);
  padding: 0.15em 0.45em;
  border-radius: 4px;
}

.ctl-formula-box {
  background: #F8FBFE;
  border: 1.5px solid #D6E8F5;
  border-radius: var(--ctl-radius-md);
  padding: 16px 20px;
  margin: 20px 0;
  text-align: center;
  font-family: var(--ctl-font-mono);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ctl-navy);
  box-shadow: inset 0 1px 3px rgba(13, 32, 64, 0.03);
  overflow-x: auto;
}

.ctl-formula-box .formula-sub {
  font-family: var(--ctl-font-body);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--ctl-text-muted);
  margin-top: 6px;
}

/* ASCII Architecture / Preformatted Code Blocks */
.ctl-code-block {
  background: #0B192C;
  color: #E2E8F0;
  font-family: var(--ctl-font-mono);
  font-size: 0.84rem;
  line-height: 1.5;
  padding: 18px 20px;
  border-radius: var(--ctl-radius-md);
  overflow-x: auto;
  margin: 22px 0;
  border: 1px solid #1E3A5F;
}

/* FAQ Accordion Styles */
.ctl-faq-section {
  margin: 32px 0 20px;
}

.ctl-faq-item {
  background: var(--ctl-surface);
  border: 1px solid var(--ctl-border);
  border-radius: var(--ctl-radius-md);
  margin-bottom: 12px;
  overflow: hidden;
  transition: border-color var(--ctl-transition-fast);
}

.ctl-faq-item:hover {
  border-color: var(--ctl-aqua);
}

.ctl-faq-question {
  padding: 16px 20px;
  font-family: var(--ctl-font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ctl-navy);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
  background: var(--ctl-card-subtle);
}

.ctl-faq-question::-webkit-details-marker {
  display: none;
}

.ctl-faq-answer {
  padding: 16px 20px;
  font-size: 0.98rem;
  line-height: 1.7;
  color: #334155;
  border-top: 1px solid var(--ctl-border-light);
  background: #FFFFFF;
}

.ctl-faq-answer p:last-child {
  margin-bottom: 0;
}

/* ==========================================================================
   Navigation Header
   ========================================================================== */
.ctl-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--ctl-border);
  box-shadow: 0 1px 6px rgba(13, 32, 64, 0.03);
  transition: all var(--ctl-transition-fast);
}

.ctl-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}

.ctl-brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--ctl-font-heading);
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--ctl-navy);
  text-decoration: none;
  letter-spacing: -0.02em;
}

.ctl-brand-logo span.accent {
  color: var(--ctl-aqua);
}

.ctl-logo-icon {
  width: 34px;
  height: 34px;
  background: linear-gradient(135deg, #00A8E8 0%, #0077CC 100%);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 1.1rem;
  box-shadow: 0 2px 8px rgba(0, 119, 204, 0.25);
}

.ctl-nav-links {
  display: flex;
  align-items: center;
  gap: 26px;
  list-style: none;
}

.ctl-nav-link {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--ctl-text-muted);
  transition: color var(--ctl-transition-fast);
  padding: 6px 0;
  position: relative;
}

.ctl-nav-link:hover, .ctl-nav-link.active {
  color: var(--ctl-navy);
}

.ctl-nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background-color: var(--ctl-aqua);
  border-radius: 2px;
}

.ctl-header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ctl-search-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--ctl-aqua-ultra-light);
  border: 1px solid #D6E8F5;
  border-radius: var(--ctl-radius-full);
  font-size: 0.85rem;
  color: var(--ctl-text-muted);
  transition: all var(--ctl-transition-fast);
}

.ctl-search-btn:hover {
  background: #FFFFFF;
  border-color: var(--ctl-aqua);
  color: var(--ctl-navy);
  box-shadow: 0 2px 6px rgba(0, 132, 209, 0.12);
}

.ctl-menu-toggle {
  display: none;
  padding: 8px;
  color: var(--ctl-navy);
  font-size: 1.5rem;
}

/* ==========================================================================
   Hero Section (Soft Water Wash Gradient & Highlight Accent)
   ========================================================================== */
.ctl-hero {
  padding: 65px 0 55px;
  background: linear-gradient(180deg, #FFFFFF 0%, #F3F9FD 45%, #E5F3FA 85%, #DCEFF8 100%);
  border-bottom: 1px solid var(--ctl-border);
  position: relative;
}

.ctl-hero-content {
  max-width: 860px;
  margin: 0 auto;
  text-align: center;
}

.ctl-hero-title {
  font-family: var(--ctl-font-heading);
  font-size: clamp(2.3rem, 5vw, 3.6rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.035em;
  color: var(--ctl-navy);
  margin: 20px 0 16px;
}

.ctl-hero-title span.highlight-line {
  color: var(--ctl-sapphire-accent);
}

.ctl-hero-desc {
  font-size: clamp(1.05rem, 2vw, 1.25rem);
  color: var(--ctl-text-muted);
  line-height: 1.6;
  max-width: 720px;
  margin: 0 auto 34px;
}

.ctl-hero-actions {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 48px;
}

.ctl-hero-trust {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  max-width: 820px;
  margin: 0 auto;
  padding-top: 30px;
  border-top: 1px solid rgba(0, 132, 209, 0.15);
}

.ctl-trust-metric {
  text-align: center;
}

.ctl-trust-metric .val {
  font-family: var(--ctl-font-mono);
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--ctl-sapphire-accent);
}

.ctl-trust-metric .label {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--ctl-text-muted);
}

/* ==========================================================================
   Interactive Symptom Diagnostic Triage Tool
   ========================================================================== */
.ctl-triage-section {
  padding: 70px 0;
  background-color: #FFFFFF;
  border-bottom: 1px solid var(--ctl-border);
}

.ctl-section-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 40px;
}

.ctl-section-title {
  font-family: var(--ctl-font-heading);
  font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  font-weight: 800;
  color: var(--ctl-navy);
  margin: 12px 0 10px;
  letter-spacing: -0.02em;
}

.ctl-section-subtitle {
  font-size: 1.05rem;
  color: var(--ctl-text-muted);
}

.ctl-triage-card {
  background: var(--ctl-bg-ice);
  border: 1.5px solid #D9ECF7;
  border-radius: var(--ctl-radius-lg);
  padding: 36px;
  box-shadow: var(--ctl-shadow-md);
}

.ctl-symptom-selector {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
  margin-bottom: 30px;
}

.ctl-symptom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  background: #FFFFFF;
  border: 1.5px solid #DCECF6;
  border-radius: var(--ctl-radius-md);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--ctl-navy);
  transition: all var(--ctl-transition-fast);
  text-align: center;
  gap: 6px;
}

.ctl-symptom-btn .icon {
  font-size: 1.8rem;
}

.ctl-symptom-btn:hover {
  border-color: var(--ctl-aqua);
  background: var(--ctl-aqua-ultra-light);
}

.ctl-symptom-btn.active {
  border-color: var(--ctl-aqua);
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(0, 132, 209, 0.2);
}

.ctl-triage-result {
  background: #FFFFFF;
  border: 1px solid #D9ECF7;
  border-radius: var(--ctl-radius-md);
  padding: 28px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  align-items: center;
  box-shadow: var(--ctl-shadow-sm);
}

@media (max-width: 768px) {
  .ctl-triage-result {
    grid-template-columns: 1fr;
  }
}

.ctl-result-title {
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--ctl-navy);
  margin-bottom: 8px;
}

/* ==========================================================================
   Interactive Water Softener & RO Sizing Calculator
   ========================================================================== */
.ctl-calc-section {
  padding: 70px 0;
  background-color: var(--ctl-bg-ice);
  border-bottom: 1px solid var(--ctl-border);
}

.ctl-calc-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 30px;
  align-items: stretch;
}

@media (max-width: 900px) {
  .ctl-calc-grid {
    grid-template-columns: 1fr;
  }
}

.ctl-calc-form {
  background: #FFFFFF;
  border: 1px solid #D9ECF7;
  border-radius: var(--ctl-radius-lg);
  padding: 32px;
  box-shadow: var(--ctl-shadow-sm);
}

.ctl-form-group {
  margin-bottom: 22px;
}

.ctl-form-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--ctl-navy);
  margin-bottom: 8px;
}

.ctl-form-label span.hint {
  font-weight: 500;
  color: var(--ctl-text-light);
  font-size: 0.8rem;
}

.ctl-form-input {
  width: 100%;
  padding: 12px 16px;
  border: 1.5px solid #D6E8F5;
  border-radius: var(--ctl-radius-sm);
  font-size: 1rem;
  background: #F8FBFE;
  transition: all var(--ctl-transition-fast);
}

.ctl-form-input:focus {
  background: #FFFFFF;
  border-color: var(--ctl-aqua);
  box-shadow: 0 0 0 3px rgba(0, 132, 209, 0.15);
}

.ctl-calc-output-card {
  background: linear-gradient(145deg, var(--ctl-ocean-deep) 0%, var(--ctl-ocean-darker) 100%);
  color: #FFFFFF;
  border-radius: var(--ctl-radius-lg);
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--ctl-shadow-md);
  border: 1px solid var(--ctl-ocean-border);
}

.ctl-calc-output-header {
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  padding-bottom: 16px;
  margin-bottom: 20px;
}

.ctl-calc-output-header h3 {
  font-size: 1.3rem;
  color: #FFFFFF;
}

.ctl-calc-metric-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16px;
}

.ctl-calc-metric-row .metric-label {
  font-size: 0.9rem;
  color: #CDE5F6;
}

.ctl-calc-metric-row .metric-val {
  font-family: var(--ctl-font-mono);
  font-size: 1.25rem;
  font-weight: 700;
  color: #38BDF8;
}

.ctl-calc-highlight-box {
  background: rgba(10, 54, 84, 0.7);
  border: 1px solid var(--ctl-ocean-border);
  border-radius: var(--ctl-radius-md);
  padding: 20px;
  text-align: center;
  margin: 10px 0 20px;
}

.ctl-calc-highlight-box .sub {
  font-size: 0.8rem;
  color: #93C5FD;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.ctl-calc-highlight-box .main-res {
  font-family: var(--ctl-font-mono);
  font-size: 2rem;
  font-weight: 800;
  color: #FFFFFF;
  margin: 4px 0;
}

/* ==========================================================================
   Article Grid & Filter Directory
   ========================================================================== */
.ctl-articles-section {
  padding: 70px 0;
  background-color: #FFFFFF;
}

.ctl-filter-tabs {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 15px;
  margin-bottom: 30px;
  scrollbar-width: thin;
}

.ctl-tab-btn {
  padding: 8px 18px;
  background: #FFFFFF;
  border: 1px solid #D6E8F5;
  border-radius: var(--ctl-radius-full);
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--ctl-text-muted);
  white-space: nowrap;
  transition: all var(--ctl-transition-fast);
}

.ctl-tab-btn:hover {
  border-color: var(--ctl-aqua);
  color: var(--ctl-navy);
}

.ctl-tab-btn.active {
  background: var(--ctl-navy);
  color: #FFFFFF;
  border-color: var(--ctl-navy);
  box-shadow: 0 2px 8px rgba(13, 32, 64, 0.2);
}

.ctl-article-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

.ctl-article-card {
  background: #FFFFFF;
  border: 1px solid var(--ctl-border);
  border-radius: var(--ctl-radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--ctl-shadow-sm);
  transition: transform var(--ctl-transition-base), box-shadow var(--ctl-transition-base), border-color var(--ctl-transition-base);
}

.ctl-article-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--ctl-shadow-md);
  border-color: var(--ctl-border-focus);
}

.ctl-article-meta-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.ctl-read-time {
  font-size: 0.78rem;
  color: var(--ctl-text-light);
  font-weight: 600;
}

.ctl-article-title {
  font-size: 1.2rem;
  font-weight: 800;
  line-height: 1.35;
  color: var(--ctl-navy);
  margin-bottom: 10px;
}

.ctl-article-snippet {
  font-size: 0.9rem;
  color: var(--ctl-text-muted);
  line-height: 1.55;
  margin-bottom: 20px;
  flex-grow: 1;
}

/* ==========================================================================
   Article Modal / Reader View
   ========================================================================== */
.ctl-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(7, 25, 48, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  visibility: hidden;
  transition: all var(--ctl-transition-base);
}

.ctl-modal-backdrop.open {
  opacity: 1;
  visibility: visible;
}

.ctl-modal-container {
  background: #FFFFFF;
  width: 100%;
  max-width: 900px;
  max-height: 90vh;
  border-radius: var(--ctl-radius-lg);
  box-shadow: var(--ctl-shadow-modal);
  overflow-y: auto;
  position: relative;
  transform: scale(0.96);
  transition: transform var(--ctl-transition-base);
  border: 1px solid var(--ctl-border);
}

.ctl-modal-backdrop.open .ctl-modal-container {
  transform: scale(1);
}

.ctl-modal-header {
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--ctl-border);
  padding: 16px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}

.ctl-modal-close-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--ctl-bg-ice);
  border: 1px solid var(--ctl-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  color: var(--ctl-navy);
  transition: all var(--ctl-transition-fast);
}

.ctl-modal-close-btn:hover {
  background: var(--ctl-orange-light);
  color: var(--ctl-orange);
}

.ctl-modal-body {
  padding: 36px 40px;
}

@media (max-width: 600px) {
  .ctl-modal-body {
    padding: 24px 20px;
  }
}

/* Scoped Typography for Article Modal Body */
.ctl-modal-body h1 {
  font-family: var(--ctl-font-heading);
  font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  font-weight: 800;
  color: var(--ctl-navy);
  line-height: 1.25;
  margin: 10px 0 18px;
  letter-spacing: -0.02em;
}

.ctl-modal-body h2 {
  font-family: var(--ctl-font-heading);
  font-size: clamp(1.25rem, 2.5vw, 1.55rem);
  font-weight: 800;
  color: var(--ctl-navy);
  line-height: 1.35;
  margin: 32px 0 14px;
  padding-bottom: 8px;
  border-bottom: 1.5px solid var(--ctl-border-light);
}

.ctl-modal-body h3 {
  font-family: var(--ctl-font-heading);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--ctl-navy);
  margin: 24px 0 10px;
}

.ctl-modal-body h4 {
  font-family: var(--ctl-font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ctl-navy);
  margin: 18px 0 8px;
}

.ctl-modal-body p {
  font-size: 1.02rem;
  line-height: 1.75;
  color: #334155;
  margin-bottom: 18px;
}

.ctl-modal-body ul, 
.ctl-modal-body ol {
  padding-left: 24px;
  margin-bottom: 20px;
}

.ctl-modal-body li {
  font-size: 1rem;
  line-height: 1.7;
  color: #334155;
  margin-bottom: 8px;
}

.ctl-modal-body strong {
  color: var(--ctl-navy);
}

.ctl-modal-body blockquote {
  background: var(--ctl-bg-ice);
  border-left: 4px solid var(--ctl-aqua);
  padding: 16px 20px;
  margin: 22px 0;
  border-radius: 0 var(--ctl-radius-sm) var(--ctl-radius-sm) 0;
  font-style: italic;
  color: var(--ctl-navy-light);
}

.ctl-modal-body hr {
  border: 0;
  border-top: 1px solid var(--ctl-border);
  margin: 32px 0;
}

/* ==========================================================================
   About Section & Footer (Rich Ocean Tone Theme)
   ========================================================================== */
.ctl-about-section {
  padding: 50px 0 70px;
  background-color: var(--ctl-bg-ice);
}

.ctl-about-container {
  background: linear-gradient(135deg, var(--ctl-ocean-deep) 0%, var(--ctl-ocean-darker) 100%);
  border-radius: var(--ctl-radius-lg);
  padding: 50px 40px;
  color: #FFFFFF;
  box-shadow: var(--ctl-shadow-lg);
  border: 1px solid var(--ctl-ocean-border);
}

.ctl-footer {
  background: var(--ctl-footer-bg);
  color: var(--ctl-footer-text);
  padding: 70px 0 30px;
  border-top: 1px solid #0E3554;
}

.ctl-footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.2fr;
  gap: 40px;
  margin-bottom: 50px;
}

@media (max-width: 900px) {
  .ctl-footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  .ctl-footer-grid {
    grid-template-columns: 1fr;
  }
}

.ctl-footer-col h5 {
  color: #FFFFFF;
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 18px;
  letter-spacing: 0.02em;
}

.ctl-footer-links {
  list-style: none;
}

.ctl-footer-links li {
  margin-bottom: 10px;
}

.ctl-footer-links a {
  color: var(--ctl-footer-text);
  font-size: 0.9rem;
  transition: color var(--ctl-transition-fast);
}

.ctl-footer-links a:hover {
  color: #38BDF8;
}

.ctl-footer-bottom {
  padding-top: 30px;
  border-top: 1px solid #0E3554;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  font-size: 0.82rem;
  color: #5F829D;
}

/* Mobile Drawer */
.ctl-mobile-drawer {
  position: fixed;
  top: 0;
  right: -300px;
  width: 280px;
  height: 100vh;
  background: #FFFFFF;
  box-shadow: var(--ctl-shadow-modal);
  z-index: 2100;
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: right var(--ctl-transition-base);
}

.ctl-mobile-drawer.open {
  right: 0;
}

.ctl-drawer-links {
  list-style: none;
  margin-top: 24px;
}

.ctl-drawer-links li {
  margin-bottom: 16px;
}

.ctl-drawer-links a {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ctl-navy);
}

/* Search Dropdown / Overlay */
.ctl-search-overlay {
  position: fixed;
  inset: 0;
  background: rgba(7, 25, 48, 0.75);
  backdrop-filter: blur(6px);
  z-index: 2050;
  display: flex;
  justify-content: center;
  padding: 60px 20px;
  opacity: 0;
  visibility: hidden;
  transition: all var(--ctl-transition-fast);
}

.ctl-search-overlay.open {
  opacity: 1;
  visibility: visible;
}

.ctl-search-box {
  background: #FFFFFF;
  width: 100%;
  max-width: 680px;
  border-radius: var(--ctl-radius-lg);
  padding: 24px;
  box-shadow: var(--ctl-shadow-modal);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--ctl-border);
}

.ctl-search-input-wrap {
  position: relative;
  margin-bottom: 20px;
}

.ctl-search-input {
  width: 100%;
  padding: 14px 20px;
  font-size: 1.1rem;
  border: 2px solid var(--ctl-border);
  border-radius: var(--ctl-radius-md);
  background: #F8FBFE;
}

.ctl-search-input:focus {
  border-color: var(--ctl-aqua);
  background: #FFFFFF;
}

.ctl-search-results-list {
  overflow-y: auto;
  flex-grow: 1;
}

.ctl-search-item {
  padding: 12px 16px;
  border-bottom: 1px solid var(--ctl-border-light);
  cursor: pointer;
  border-radius: var(--ctl-radius-sm);
  transition: background var(--ctl-transition-fast);
}

.ctl-search-item:hover {
  background: var(--ctl-bg-ice);
}

.ctl-search-item h4 {
  font-size: 1rem;
  color: var(--ctl-navy);
  margin-bottom: 4px;
}

.ctl-search-item p {
  font-size: 0.82rem;
  color: var(--ctl-text-muted);
}
